let pessoa = {
  nome: "João",
  idade: 30,
  cidade: "São Paulo"
};

console.log(pessoa.nome); // Mostra apenas o nome
pessoa.idade = 35; // Alterando a idade

console.log(pessoa); // Mostra o objeto atualizado
pessoa.profissao = "Engenheiro";

console.log(pessoa); // Objeto com a nova propriedade
