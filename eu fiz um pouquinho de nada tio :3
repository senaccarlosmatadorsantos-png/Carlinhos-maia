<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Prática de if/else</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Syne:wght@700;800&display=swap" rel="stylesheet">
  <style>
    :root{
      --bg: #f7f3ea;
      --surface: rgba(255,255,255,0.58);
      --surface-strong: rgba(255,255,255,0.78);
      --text: #1f1a17;
      --muted: #6c625a;
      --line: rgba(31,26,23,0.12);
      --accent: #c96f3b;
      --accent-2: #2f6b5f;
      --success: #1f7a4d;
      --error: #b53a2d;
      --shadow: 0 20px 60px rgba(74, 48, 28, 0.12);
      --radius: 24px;
    }

    *{
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html{
      scroll-behavior: smooth;
    }

    body{
      font-family: "Space Grotesk", sans-serif;
      color: var(--text);
      background:
        radial-gradient(circle at top left, rgba(201,111,59,0.18), transparent 28%),
        radial-gradient(circle at bottom right, rgba(47,107,95,0.16), transparent 30%),
        linear-gradient(180deg, #fbf8f2 0%, var(--bg) 100%);
      min-height: 100vh;
      overflow-x: hidden;
    }

    body::before{
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(31,26,23,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(31,26,23,0.03) 1px, transparent 1px);
      background-size: 34px 34px;
      mask-image: linear-gradient(to bottom, rgba(0,0,0,0.4), transparent 85%);
    }

    .page{
      width: min(1180px, calc(100% - 32px));
      margin: 0 auto;
      padding: 28px 0 48px;
    }

    .hero{
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 28px;
      align-items: end;
      padding: 24px 0 40px;
    }

    .eyebrow{
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: var(--accent-2);
      margin-bottom: 18px;
    }

    .eyebrow::before{
      content: "";
      width: 38px;
      height: 1px;
      background: currentColor;
    }

    h1{
      font-family: "Syne", sans-serif;
      font-size: clamp(2.8rem, 6vw, 6rem);
      line-height: 0.95;
      letter-spacing: -0.05em;
      max-width: 10ch;
    }

    .hero p{
      margin-top: 18px;
      max-width: 56ch;
      color: var(--muted);
      font-size: clamp(1rem, 1.6vw, 1.08rem);
      line-height: 1.7;
    }

    .hero-art{
      min-height: 280px;
      border-radius: 32px;
      position: relative;
      overflow: hidden;
      border: 1px solid var(--line);
      background:
        linear-gradient(135deg, rgba(201,111,59,0.15), rgba(255,255,255,0.35)),
        linear-gradient(225deg, rgba(47,107,95,0.18), transparent 60%);
      box-shadow: var(--shadow);
      backdrop-filter: blur(12px);
    }

    .hero-art::before,
    .hero-art::after{
      content: "";
      position: absolute;
      border-radius: 50%;
      filter: blur(2px);
    }

    .hero-art::before{
      width: 180px;
      height: 180px;
      background: rgba(201,111,59,0.22);
      top: 18px;
      right: 18px;
    }

    .hero-art::after{
      width: 220px;
      height: 220px;
      background: rgba(47,107,95,0.18);
      bottom: -30px;
      left: -20px;
    }

    .art-lines{
      position: absolute;
      inset: 0;
      background:
        repeating-linear-gradient(
          120deg,
          transparent 0 18px,
          rgba(31,26,23,0.05) 18px 19px
        );
      opacity: 0.6;
    }

    .art-badge{
      position: absolute;
      left: 24px;
      top: 24px;
      padding: 12px 16px;
      border: 1px solid rgba(31,26,23,0.08);
      background: rgba(255,255,255,0.62);
      backdrop-filter: blur(10px);
      border-radius: 999px;
      font-size: 0.82rem;
      color: var(--muted);
    }

    .art-number{
      position: absolute;
      right: 24px;
      bottom: 22px;
      font-family: "Syne", sans-serif;
      font-size: clamp(3rem, 9vw, 6rem);
      line-height: 1;
      color: rgba(31,26,23,0.16);
      letter-spacing: -0.06em;
    }

    main{
      display: grid;
      gap: 22px;
    }

    .section{
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: 22px;
      align-items: stretch;
    }

    .section-head,
    .panel{
      border: 1px solid var(--line);
      background: var(--surface);
      backdrop-filter: blur(14px);
      box-shadow: var(--shadow);
      border-radius: var(--radius);
    }

    .section-head{
      padding: 28px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: 100%;
    }

    .section-index{
      font-family: "Syne", sans-serif;
      font-size: 0.95rem;
      color: var(--accent);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .section-head h2{
      font-family: "Syne", sans-serif;
      font-size: clamp(1.8rem, 3vw, 2.8rem);
      line-height: 0.95;
      letter-spacing: -0.04em;
      margin-top: 14px;
    }

    .section-head p{
      color: var(--muted);
      margin-top: 14px;
      line-height: 1.7;
      max-width: 26ch;
    }

    .panel{
      padding: 30px;
      background: var(--surface-strong);
    }

    .panel-grid{
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px 20px;
      align-items: start;
    }

    .field{
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .field.full{
      grid-column: 1 / -1;
    }

    label{
      font-size: 0.95rem;
      font-weight: 500;
      color: var(--text);
    }

    input{
      width: 100%;
      border: 1px solid rgba(31,26,23,0.12);
      background: rgba(255,255,255,0.72);
      border-radius: 16px;
      padding: 15px 16px;
      font: inherit;
      color: var(--text);
      outline: none;
      transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    input::placeholder{
      color: #988d84;
    }

    input:focus{
      border-color: var(--accent);
      box-shadow: 0 0 0 4px rgba(201,111,59,0.12);
      background: #fff;
      transform: translateY(-1px);
    }

    .actions{
      grid-column: 1 / -1;
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
      margin-top: 4px;
    }

    button{
      appearance: none;
      border: none;
      cursor: pointer;
      font: inherit;
      font-weight: 700;
      padding: 14px 22px;
      border-radius: 999px;
      color: #fff;
      background: linear-gradient(135deg, var(--accent), #b65522);
      box-shadow: 0 14px 28px rgba(201,111,59,0.24);
      transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
    }

    button:hover{
      transform: translateY(-2px) scale(1.02);
      box-shadow: 0 18px 32px rgba(201,111,59,0.28);
      filter: saturate(1.05);
    }

    button:active{
      transform: translateY(0) scale(0.99);
    }

    .result{
      min-height: 52px;
      display: flex;
      align-items: center;
      padding: 14px 16px;
      border-radius: 18px;
      background: rgba(47,107,95,0.08);
      border: 1px solid rgba(47,107,95,0.14);
      color: var(--text);
      font-weight: 500;
      line-height: 1.5;
      width: min(100%, 520px);
    }

    .result.error{
      background: rgba(181,58,45,0.08);
      border-color: rgba(181,58,45,0.18);
      color: var(--error);
    }

    .result.success{
      background: rgba(31,122,77,0.08);
      border-color: rgba(31,122,77,0.18);
      color: var(--success);
    }

    .result.neutral{
      background: rgba(31,26,23,0.05);
      border-color: rgba(31,26,23,0.08);
      color: var(--muted);
    }

    .reveal{
      opacity: 0;
      transform: translateY(28px);
      animation: rise 0.85s cubic-bezier(.2,.7,.2,1) forwards;
    }

    .delay-1{ animation-delay: 0.08s; }
    .delay-2{ animation-delay: 0.18s; }
    .delay-3{ animation-delay: 0.28s; }
    .delay-4{ animation-delay: 0.38s; }

    .observe{
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }

    .observe.visible{
      opacity: 1;
      transform: translateY(0);
    }

    footer{
      padding: 30px 0 8px;
      color: var(--muted);
      font-size: 0.92rem;
    }

    @keyframes rise{
      to{
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 980px){
      .hero,
      .section{
        grid-template-columns: 1fr;
      }

      .hero-art{
        min-height: 220px;
      }

      .section-head p{
        max-width: 100%;
      }
    }

    @media (max-width: 640px){
      .page{
        width: min(100% - 20px, 1180px);
        padding-top: 18px;
      }

      .panel,
      .section-head{
        padding: 22px;
        border-radius: 22px;
      }

      .panel-grid{
        grid-template-columns: 1fr;
      }

      .actions{
        align-items: stretch;
      }

      button,
      .result{
        width: 100%;
      }

      h1{
        max-width: 12ch;
      }
    }
  </style>
</head>
<body>
  <div class="page">
    <header class="hero">
      <div>
        <div class="eyebrow reveal delay-1">Exercícios com JavaScript</div>
        <h1 class="reveal delay-2">Verificações simples com if e else</h1>
        <p class="reveal delay-3">
          Uma interface prática com três funcionalidades: verificador de idade, tela de login
          e cadastro com validação. Tudo em uma única página, com retorno imediato na tela.
        </p>
      </div>

      <div class="hero-art reveal delay-4" aria-hidden="true">
        <div class="art-lines"></div>
        <div class="art-badge">Inputs + Botões + Regras</div>
        <div class="art-number">01</div>
      </div>
    </header>

    <main>
      <section class="section observe">
        <aside class="section-head">
          <div>
            <div class="section-index">Exercício 1</div>
            <h2>Verificador de Idade</h2>
            <p>Digite uma idade e veja a resposta com base na regra de maioridade.</p>
          </div>
        </aside>

        <div class="panel">
          <div class="panel-grid">
            <div class="field full">
              <label for="idade">Idade</label>
              <input type="number" id="idade" placeholder="Digite sua idade" min="0" />
            </div>

            <div class="actions">
              <button type="button" id="btnIdade">Verificar</button>
              <div class="result neutral" id="resultadoIdade">A resposta aparecerá aqui.</div>
            </div>
          </div>
        </div>
      </section>

      <section class="section observe">
        <aside class="section-head">
          <div>
            <div class="section-index">Exercício 2</div>
            <h2>Tela de Login</h2>
            <p>Use as credenciais corretas para validar o acesso: usuário admin e senha 1234.</p>
          </div>
        </aside>

        <div class="panel">
          <div class="panel-grid">
            <div class="field">
              <label for="usuario">Usuário</label>
              <input type="text" id="usuario" placeholder="Digite o usuário" />
            </div>

            <div class="field">
              <label for="senhaLogin">Senha</label>
              <input type="password" id="senhaLogin" placeholder="Digite a senha" />
            </div>

            <div class="actions">
              <button type="button" id="btnLogin">Entrar</button>
              <div class="result neutral" id="resultadoLogin">O resultado do login aparecerá aqui.</div>
            </div>
          </div>
        </div>
      </section>

      <section class="section observe">
        <aside class="section-head">
          <div>
            <div class="section-index">Exercício 3</div>
            <h2>Cadastro com Validação</h2>
            <p>Preencha os campos corretamente. A senha precisa ter pelo menos 6 caracteres.</p>
          </div>
        </aside>

        <div class="panel">
          <div class="panel-grid">
            <div class="field">
              <label for="nome">Nome</label>
              <input type="text" id="nome" placeholder="Digite seu nome" />
            </div>

            <div class="field">
              <label for="email">Email</label>
              <input type="email" id="email" placeholder="Digite seu email" />
            </div>

            <div class="field full">
              <label for="senhaCadastro">Senha</label>
              <input type="password" id="senhaCadastro" placeholder="Crie uma senha" />
            </div>

            <div class="actions">
              <button type="button" id="btnCadastro">Cadastrar</button>
              <div class="result neutral" id="resultadoCadastro">O status do cadastro aparecerá aqui.</div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer>
      Página demonstrativa de lógica condicional com JavaScript.
    </footer>
  </div>

  <script>
    function definirResultado(elemento, mensagem, tipo) {
      elemento.textContent = mensagem;
      elemento.className = "result " + tipo;
    }

    // Exercício 1 - Verificador de idade
    const btnIdade = document.getElementById("btnIdade");
    const idadeInput = document.getElementById("idade");
    const resultadoIdade = document.getElementById("resultadoIdade");

    btnIdade.addEventListener("click", function () {
      const idade = Number(idadeInput.value);

      if (idadeInput.value === "") {
        definirResultado(resultadoIdade, "Digite uma idade válida", "error");
      } else if (idade < 18) {
        definirResultado(resultadoIdade, "Você é menor de idade", "error");
      } else {
        definirResultado(resultadoIdade, "Você é maior de idade", "success");
      }
    });

    // Exercício 2 - Login
    const btnLogin = document.getElementById("btnLogin");
    const usuarioInput = document.getElementById("usuario");
    const senhaLoginInput = document.getElementById("senhaLogin");
    const resultadoLogin = document.getElementById("resultadoLogin");

    btnLogin.addEventListener("click", function () {
      const usuario = usuarioInput.value;
      const senha = senhaLoginInput.value;

      if (usuario === "admin" && senha === "1234") {
        definirResultado(resultadoLogin, "Login realizado com sucesso", "success");
      } else {
        definirResultado(resultadoLogin, "Usuário ou senha inválidos", "error");
      }
    });

    // Exercício 3 - Cadastro com validação
    const btnCadastro = document.getElementById("btnCadastro");
    const nomeInput = document.getElementById("nome");
    const emailInput = document.getElementById("email");
    const senhaCadastroInput = document.getElementById("senhaCadastro");
    const resultadoCadastro = document.getElementById("resultadoCadastro");

    btnCadastro.addEventListener("click", function () {
      const nome = nomeInput.value.trim();
      const email = emailInput.value.trim();
      const senha = senhaCadastroInput.value;

      if (nome === "" || email === "" || senha === "") {
        definirResultado(resultadoCadastro, "Preencha todos os campos", "error");
      } else if (senha.length < 6) {
        definirResultado(resultadoCadastro, "Senha muito curta", "error");
      } else {
        definirResultado(resultadoCadastro, "Cadastro realizado com sucesso", "success");
      }
    });

    // Animação ao rolar
    const observados = document.querySelectorAll(".observe");
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.16 });

    observados.forEach((item) => observer.observe(item));
  </script>
</body>
</html>
