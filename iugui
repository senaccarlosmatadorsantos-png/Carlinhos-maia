<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Portfólio de Programação - Seu Nome</title>
  <style>
    /* Reset básico */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f4f7f8;
      color: #333;
      line-height: 1.6;
      padding: 20px;
    }

    header {
      text-align: center;
      padding-bottom: 30px;
      border-bottom: 2px solid #007acc;
    }

    header h1 {
      font-size: 2.8rem;
      color: #007acc;
      margin-bottom: 5px;
    }

    header p {
      font-size: 1.2rem;
      color: #555;
    }

    nav {
      margin-top: 10px;
    }

    nav a {
      color: #007acc;
      text-decoration: none;
      margin: 0 10px;
      font-weight: bold;
      transition: color 0.3s ease;
    }

    nav a:hover {
      color: #005f99;
    }

    section {
      max-width: 900px;
      margin: 40px auto;
      background: white;
      padding: 25px 30px;
      border-radius: 8px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    section h2 {
      color: #007acc;
      margin-bottom: 20px;
      border-bottom: 2px solid #007acc;
      padding-bottom: 8px;
    }

    /* Sobre Mim */
    #about p {
      font-size: 1.1rem;
      color: #444;
    }

    /* Habilidades */
    #skills ul {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 15px;
    }

    #skills li {
      background-color: #007acc;
      color: white;
      padding: 10px 15px;
      border-radius: 20px;
      font-weight: 600;
      box-shadow: 0 2px 5px rgba(0,0,0,0.15);
    }

    /* Projetos */
    #projects .project {
      margin-bottom: 25px;
      border-bottom: 1px solid #ddd;
      padding-bottom: 15px;
    }

    #projects .project:last-child {
      border-bottom: none;
    }

    #projects .project h3 {
      color: #005f99;
      margin-bottom: 8px;
    }

    #projects .project p {
      color: #555;
      margin-bottom: 8px;
    }

    #projects .project a {
      color: #007acc;
      text-decoration: none;
      font-weight: bold;
    }

    #projects .project a:hover {
      text-decoration: underline;
    }

    /* Contato */
    #contact p {
      font-size: 1.1rem;
      margin-bottom: 10px;
    }

    #contact a {
      color: #007acc;
      text-decoration: none;
      font-weight: bold;
    }

    #contact a:hover {
      text-decoration: underline;
    }

    /* Responsividade */
    @media (max-width: 600px) {
      #skills ul {
        justify-content: center;
      }
    }
  </style>
</head>
<body>

  <header>
    <h1>Seu Nome</h1>
    <p>Desenvolvedor(a) Front-end | Back-end | Full Stack</p>
    <nav
