<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Busca de CEP</title>
  <meta name="description" content="Sistema de busca de CEP com validação, layout responsivo e exibição completa dos dados retornados pela API." />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    :root{
      --bg: #f4efe7;
      --bg-soft: #efe6d8;
      --surface: rgba(255,255,255,0.58);
      --surface-strong: rgba(255,255,255,0.82);
      --text: #1f1a17;
      --muted: #6a5d54;
      --line: rgba(74, 55, 42, 0.14);
      --primary: #7a4b2a;
      --primary-2: #b86d3a;
      --accent: #21493d;
      --danger: #b42318;
      --success: #1f7a4d;
      --shadow: 0 24px 60px rgba(69, 42, 25, 0.14);
      --radius-xl: 28px;
      --radius-lg: 20px;
      --radius-md: 14px;
      --container: 1180px;
    }

    *{
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html{
      scroll-behavior: smooth;
    }

    body{
      min-height: 100vh;
      font-family: "Manrope", sans-serif;
      color: var(--text);
      background:
        radial-gradient(circle at 15% 20%, rgba(184,109,58,0.16), transparent 28%),
        radial-gradient(circle at 85% 15%, rgba(33,73,61,0.14), transparent 24%),
        radial-gradient(circle at 70% 80%, rgba(122,75,42,0.12), transparent 25%),
        linear-gradient(135deg, #f7f1e9 0%, #f2eadf 48%, #ece1d3 100%);
      overflow-x: hidden;
    }

    body::before{
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      opacity: 0.3;
      background-image:
        linear-gradient(rgba(122,75,42,0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(122,75,42,0.04) 1px, transparent 1px);
      background-size: 24px 24px;
      mask-image: linear-gradient(to bottom, rgba(0,0,0,0.35), transparent 70%);
    }

    .page{
      width: min(100% - 32px, var(--container));
      margin: 0 auto;
      position: relative;
    }

    .topbar{
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 26px 0 10px;
      gap: 16px;
    }

    .brand{
      display: inline-flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: var(--text);
    }

    .brand-mark{
      width: 42px;
      height: 42px;
      border-radius: 14px;
      background:
        linear-gradient(145deg, var(--primary), var(--primary-2));
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.45),
        0 10px 24px rgba(122,75,42,0.26);
      position: relative;
      overflow: hidden;
    }

    .brand-mark::before,
    .brand-mark::after{
      content: "";
      position: absolute;
      border-radius: 999px;
      background: rgba(255,255,255,0.35);
    }

    .brand-mark::before{
      width: 26px;
      height: 26px;
      top: -5px;
      right: -4px;
    }

    .brand-mark::after{
      width: 18px;
      height: 18px;
      bottom: 4px;
      left: 5px;
    }

    .brand-text{
      font-family: "Space Grotesk", sans-serif;
      font-weight: 700;
      font-size: 1rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .hero{
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 28px;
      align-items: stretch;
      padding: 28px 0 42px;
    }

    .hero-copy,
    .search-panel,
    .info-panel{
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      background: var(--surface);
      border: 1px solid rgba(255,255,255,0.45);
      box-shadow: var(--shadow);
    }

    .hero-copy{
      border-radius: var(--radius-xl);
      padding: clamp(28px, 4vw, 48px);
      position: relative;
      overflow: hidden;
      min-height: 420px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .hero-copy::before{
      content: "";
      position: absolute;
      inset: auto -80px -80px auto;
      width: 240px;
      height: 240px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(184,109,58,0.22), transparent 65%);
    }

    .eyebrow{
      display: inline-flex;
      align-items: center;
      gap: 10px;
      width: fit-content;
      padding: 10px 14px;
      border-radius: 999px;
      background: rgba(255,255,255,0.56);
      border: 1px solid rgba(122,75,42,0.12);
      color: var(--accent);
      font-size: 0.86rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .eyebrow::before{
      content: "";
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: linear-gradient(145deg, var(--accent), #3e816d);
      box-shadow: 0 0 0 6px rgba(33,73,61,0.08);
    }

    h1{
      font-family: "Space Grotesk", sans-serif;
      font-size: clamp(2.4rem, 6vw, 5.2rem);
      line-height: 0.95;
      letter-spacing: -0.05em;
      max-width: 11ch;
      margin: 22px 0 18px;
    }

    .hero-copy p{
      max-width: 58ch;
      color: var(--muted);
      font-size: clamp(1rem, 1.8vw, 1.08rem);
      line-height: 1.75;
    }

    .hero-meta{
      display: grid;
      grid-template-columns: repeat(3, minmax(0,1fr));
      gap: 14px;
      margin-top: 34px;
    }

    .meta-item{
      padding: 18px 18px 16px;
      border-top: 1px solid var(--line);
    }

    .meta-item strong{
      display: block;
      font-family: "Space Grotesk", sans-serif;
      font-size: 1.35rem;
      margin-bottom: 6px;
    }

    .meta-item span{
      color: var(--muted);
      font-size: 0.92rem;
    }

    .sidebar{
      display: grid;
      grid-template-rows: auto 1fr;
      gap: 20px;
    }

    .search-panel{
      border-radius: var(--radius-xl);
      padding: clamp(22px, 3vw, 30px);
      position: relative;
      overflow: hidden;
    }

    .search-panel::after{
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        linear-gradient(120deg, rgba(255,255,255,0.3), transparent 35%),
        radial-gradient(circle at top right, rgba(184,109,58,0.12), transparent 30%);
    }

    .panel-title{
      font-family: "Space Grotesk", sans-serif;
      font-size: clamp(1.5rem, 2vw, 2rem);
      letter-spacing: -0.04em;
      margin-bottom: 8px;
    }

    .panel-desc{
      color: var(--muted);
      line-height: 1.7;
      margin-bottom: 22px;
    }

    .search-form{
      display: grid;
      gap: 14px;
      position: relative;
      z-index: 1;
    }

    .field{
      display: grid;
      gap: 8px;
    }

    label{
      font-size: 0.92rem;
      font-weight: 700;
      color: var(--accent);
    }

    .input-wrap{
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 12px;
    }

    input{
      width: 100%;
      min-height: 58px;
      border: 1px solid rgba(122,75,42,0.16);
      border-radius: 16px;
      background: var(--surface-strong);
      padding: 0 18px;
      color: var(--text);
      font-size: 1rem;
      font-family: "Manrope", sans-serif;
      outline: none;
      transition: border-color .25s ease, box-shadow .25s ease, transform .2s ease;
    }

    input:focus{
      border-color: rgba(122,75,42,0.45);
      box-shadow: 0 0 0 4px rgba(184,109,58,0.12);
    }

    input::placeholder{
      color: #98877b;
    }

    button{
      min-height: 58px;
      border: 0;
      border-radius: 16px;
      padding: 0 22px;
      font-family: "Space Grotesk", sans-serif;
      font-size: 0.98rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      cursor: pointer;
      color: #fff8f3;
      background: linear-gradient(145deg, var(--primary), var(--primary-2));
      box-shadow: 0 14px 26px rgba(122,75,42,0.24);
      transition: transform .2s ease, box-shadow .25s ease, filter .25s ease;
    }

    button:hover{
      transform: translateY(-2px) scale(1.01);
      box-shadow: 0 18px 30px rgba(122,75,42,0.28);
      filter: saturate(1.05);
    }

    button:active{
      transform: translateY(0) scale(0.99);
    }

    .message{
      min-height: 24px;
      font-size: 0.95rem;
      font-weight: 700;
      padding-top: 4px;
    }

    .message.error{
      color: var(--danger);
    }

    .message.success{
      color: var(--success);
    }

    .helper{
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 8px;
    }

    .chip{
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 12px;
      border-radius: 999px;
      background: rgba(255,255,255,0.62);
      border: 1px solid var(--line);
      font-size: 0.86rem;
      color: var(--muted);
    }

    .chip strong{
      color: var(--text);
      font-weight: 800;
    }

    .info-panel{
      border-radius: var(--radius-xl);
      padding: clamp(22px, 3vw, 30px);
      display: grid;
      align-content: start;
      gap: 18px;
    }

    .results-header{
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 16px;
      padding-bottom: 6px;
      border-bottom: 1px solid var(--line);
    }

    .results-header small{
      color: var(--muted);
      font-size: 0.9rem;
    }

    .result-grid{
      display: grid;
      grid-template-columns: repeat(2, minmax(0,1fr));
      gap: 14px;
    }

    .result-item{
      padding: 16px 0 14px;
      border-bottom: 1px solid var(--line);
      animation: rise .6s ease both;
    }

    .result-item .label{
      display: block;
      font-size: 0.8rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 7px;
      font-weight: 800;
    }

    .result-item .value{
      font-size: 1.06rem;
      font-weight: 700;
      color: var(--text);
      word-break: break-word;
    }

    .empty-state{
      padding: 14px 0 4px;
      color: var(--muted);
      line-height: 1.75;
    }

    .footer{
      padding: 0 0 32px;
      color: var(--muted);
      font-size: 0.92rem;
    }

    .reveal{
      opacity: 0;
      transform: translateY(22px);
      transition: opacity .7s ease, transform .7s ease;
    }

    .reveal.visible{
      opacity: 1;
      transform: translateY(0);
    }

    .stagger-1{ animation: entry .7s ease .05s both; }
    .stagger-2{ animation: entry .7s ease .15s both; }
    .stagger-3{ animation: entry .7s ease .25s both; }
    .stagger-4{ animation: entry .7s ease .35s both; }

    @keyframes entry{
      from{ opacity: 0; transform: translateY(18px); }
      to{ opacity: 1; transform: translateY(0); }
    }

    @keyframes rise{
      from{ opacity: 0; transform: translateY(14px); }
      to{ opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 980px){
      .hero{
        grid-template-columns: 1fr;
      }

      .hero-meta{
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px){
      .page{
        width: min(100% - 20px, var(--container));
      }

      .topbar{
        padding-top: 18px;
      }

      .hero{
        gap: 18px;
        padding-top: 14px;
      }

      .hero-copy,
      .search-panel,
      .info-panel{
        border-radius: 22px;
      }

      .input-wrap{
        grid-template-columns: 1fr;
      }

      .result-grid{
        grid-template-columns: 1fr;
      }

      button{
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <div class="page">
    <header class="topbar reveal">
      <a href="#" class="brand" aria-label="Início">
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand-text">Busca CEP</span>
      </a>
    </header>

    <main class="hero">
      <section class="hero-copy stagger-1">
        <div>
          <span class="eyebrow">Consulta inteligente</span>
          <h1>Encontre um endereço pelo CEP.</h1>
          <p>
            Digite um CEP válido para consultar rapidamente os dados completos do endereço.
            O sistema valida o campo, busca as informações pela API e exibe mensagem caso o CEP não exista.
          </p>
        </div>

        <div class="hero-meta">
          <div class="meta-item">
            <strong>Rua</strong>
            <span>Exibição do logradouro retornado pela API.</span>
          </div>
          <div class="meta-item">
            <strong>Bairro</strong>
            <span>Consulta detalhada com localização complementar.</span>
          </div>
          <div class="meta-item">
            <strong>Cidade / Estado</strong>
            <span>Mostra também todos os demais campos disponíveis.</span>
          </div>
        </div>
      </section>

      <aside class="sidebar">
        <section class="search-panel stagger-2">
          <h2 class="panel-title">Consultar CEP</h2>
          <p class="panel-desc">
            Informe o CEP com ou sem hífen. O sistema formata, valida e retorna todas as informações disponíveis.
          </p>

          <form class="search-form" id="cepForm" novalidate>
            <div class="field">
              <label for="cep">CEP</label>
              <div class="input-wrap">
                <input
                  type="text"
                  id="cep"
                  name="cep"
                  inputmode="numeric"
                  maxlength="9"
                  placeholder="Ex.: 01001-000"
                  aria-describedby="mensagem"
                />
                <button type="submit">Buscar</button>
              </div>
            </div>

            <div id="mensagem" class="message" role="status" aria-live="polite"></div>

            <div class="helper">
              <span class="chip"><strong>Validação</strong> campo obrigatório</span>
              <span class="chip"><strong>API</strong> ViaCEP</span>
              <span class="chip"><strong>Resposta</strong> completa</span>
            </div>
          </form>
        </section>

        <section class="info-panel stagger-3 reveal" aria-labelledby="resultadoTitulo">
          <div class="results-header">
            <div>
              <h2 class="panel-title" id="resultadoTitulo">Resultado</h2>
              <small>Dados retornados pela consulta</small>
            </div>
          </div>

          <div id="resultado">
            <p class="empty-state">
              Nenhuma consulta realizada ainda. Digite um CEP para visualizar rua, bairro, cidade, estado e demais informações.
            </p>
          </div>
        </section>
      </aside>
    </main>

    <footer class="footer reveal">
      <p>Projeto responsivo de busca de CEP com validação, tratamento de erro e interface moderna.</p>
    </footer>
  </div>

  <script>
    const form = document.getElementById("cepForm");
    const cepInput = document.getElementById("cep");
    const mensagem = document.getElementById("mensagem");
    const resultado = document.getElementById("resultado");

    const labels = {
      cep: "CEP",
      logradouro: "Rua",
      complemento: "Complemento",
      unidade: "Unidade",
      bairro: "Bairro",
      localidade: "Cidade",
      uf: "Estado",
      estado: "Estado por extenso",
      regiao: "Região",
      ibge: "IBGE",
      gia: "GIA",
      ddd: "DDD",
      siafi: "SIAFI"
    };

    function setMessage(text, type = "") {
      mensagem.textContent = text;
      mensagem.className = "message";
      if (type) mensagem.classList.add(type);
    }

    function formatCep(value) {
      const numbers = value.replace(/\D/g, "").slice(0, 8);
      if (numbers.length > 5) {
        return numbers.replace(/^(\d{5})(\d{1,3})$/, "$1-$2");
      }
      return numbers;
    }

    function renderResultado(data) {
      const entries = Object.entries(data).filter(([_, value]) => value !== undefined && value !== null && value !== "");

      const priorityOrder = [
        "cep",
        "logradouro",
        "complemento",
        "unidade",
        "bairro",
        "localidade",
        "uf",
        "estado",
        "regiao",
        "ibge",
        "gia",
        "ddd",
        "siafi"
      ];

      entries.sort((a, b) => {
        return priorityOrder.indexOf(a[0]) - priorityOrder.indexOf(b[0]);
      });

      resultado.innerHTML = `
        <div class="result-grid">
          ${entries.map(([key, value], index) => `
            <div class="result-item" style="animation-delay:${index * 0.05}s">
              <span class="label">${labels[key] || key}</span>
              <span class="value">${value}</span>
            </div>
          `).join("")}
        </div>
      `;
    }

    function limparResultado() {
      resultado.innerHTML = `
        <p class="empty-state">
          Nenhum dado para exibir no momento.
        </p>
      `;
    }

    cepInput.addEventListener("input", (e) => {
      e.target.value = formatCep(e.target.value);
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const cep = cepInput.value.trim();

      if (cepInput.value == "") {
        setMessage("Por favor, informe um CEP.", "error");
        limparResultado();
        cepInput.focus();
        return;
      }

      const cepNumerico = cep.replace(/\D/g, "");

      if (cepNumerico.length !== 8) {
        setMessage("CEP inválido. Digite um CEP com 8 números.", "error");
        limparResultado();
        cepInput.focus();
        return;
      }

      setMessage("Consultando CEP...", "success");
      resultado.innerHTML = `
        <p class="empty-state">
          Buscando informações do endereço...
        </p>
      `;

      try {
        const response = await fetch(`https://viacep.com.br/ws/${cepNumerico}/json/`);
        const data = await response.json();

        if (data.erro) {
          setMessage("CEP não encontrado. Verifique e tente novamente.", "error");
          limparResultado();
          return;
        }

        setMessage("CEP encontrado com sucesso.", "success");
        renderResultado(data);
      } catch (error) {
        setMessage("Não foi possível consultar o CEP no momento.", "error");
        limparResultado();
      }
    });

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
        }
      });
    }, { threshold: 0.15 });

    document.querySelectorAll(".reveal").forEach(el => observer.observe(el));
  </script>
</body>
</html>
