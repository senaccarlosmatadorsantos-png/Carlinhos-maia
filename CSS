* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #1e1e2f;
    display: flex;
    justify-content: center;
    padding: 40px;
}

.container {
    background: white;
    width: 500px;
    padding: 25px;
    border-radius: 15px;
    box-shadow: 0 0 15px rgba(0,0,0,0.3);
}

h1 {
    text-align: center;
    margin-bottom: 20px;
    color: #333;
}

.entrada {
    display: flex;
    gap: 10px;
}

input {
    flex: 1;
    padding: 10px;
    border: 2px solid #ccc;
    border-radius: 8px;
}

button {
    padding: 10px 15px;
    background: #6c63ff;
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
}

button:hover {
    background: #574fd6;
}

ul {
    list-style: none;
    margin-top: 20px;
}

li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #f4f4f4;
    padding: 10px;
    margin-top: 10px;
    border-radius: 8px;
}

.assistido {
    text-decoration: line-through;
    color: green;
}

.botoes {
    display: flex;
    gap: 5px;
}

.assistir {
    background: green;
}

.assistir:hover {
    background: darkgreen;
}

.remover {
    background: red;
}

.remover:hover {
    background: darkred;
}
